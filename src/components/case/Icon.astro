---
import * as icons from "lucide-static";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls = "" } = Astro.props;
const raw = (icons as unknown as Record<string, string>)[name] ?? "";
const svg = raw
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.6"')
  .replace("<svg", '<svg aria-hidden="true" focusable="false"');
---

<span class:list={["icon", cls]} set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
</style>
