---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="next-list">
  {items.map((item) => (
    <li class="next-item" data-r>{item}</li>
  ))}
</ul>

<style>
  .next-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .next-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: clamp(14px, 2.5vh, 20px) 0;
    border-top: 1px solid var(--rule);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .next-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .next-item:last-child {
    padding-bottom: 0;
  }

  .next-item::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: var(--ink-3);
    position: relative;
    top: -2px;
  }
</style>
