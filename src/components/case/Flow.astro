---
import type { Step } from "../../data/cases";

interface Props {
  steps: Step[];
  note?: string;
}

const { steps, note } = Astro.props;
---

<div class="flow-container">
  <ol class="flow-list">
    {steps.map((step, i) => {
      const idx = String(i + 1).padStart(2, "0");
      return (
        <li class:list={["flow-step", { "is-key": step.key }]}>
          <span class="flow-index mono">{idx}</span>
          <div class="flow-body">
            <span class="flow-where mono">{step.where}</span>
            <h3 class="flow-title">
              {step.key && <span class="key-dot" aria-hidden="true" />}
              {step.title}
            </h3>
            <p class="flow-detail">{step.detail}</p>
          </div>
        </li>
      );
    })}
  </ol>
  {note && <p class="flow-note">{note}</p>}
</div>

<style>
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow-step {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(20px, 3.5vh, 28px) 0;
    border-top: 1px solid var(--rule);
  }

  .flow-step:first-child {
    border-top: none;
    padding-top: 0;
  }

  .flow-index {
    font-family: var(--mono);
    color: var(--ink-3);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .flow-step.is-key .flow-index {
    color: var(--flag);
  }

  .flow-body {
    min-width: 0;
  }

  .flow-where {
    display: block;
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    margin-bottom: 6px;
  }

  .flow-title {
    font-family: var(--display);
    font-weight: 380;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .key-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--flag);
    vertical-align: middle;
    margin-right: 8px;
    margin-bottom: 2px;
  }

  .flow-detail {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.5;
  }

  .flow-note {
    margin-top: clamp(24px, 4vh, 36px);
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .flow-step {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
