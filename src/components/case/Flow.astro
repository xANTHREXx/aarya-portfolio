---
import type { Step } from "../../data/cases";
import Icon from "./Icon.astro";
import { whereIcon } from "./icons";

interface Props {
  steps: Step[];
  note?: string;
}

const { steps, note } = Astro.props;
---

<div class="flow-container">
  <ol class="flow-list">
    {steps.map((step, i) => {
      const idx = String(i + 1).padStart(2, "0");
      return (
        <li class:list={["flow-step", { "is-key": step.key }]} data-r>
          <span class="flow-node" aria-hidden="true"><Icon name={whereIcon(step.where)} size={20} /></span>
          <div class="flow-body">
            <span class="flow-where mono"><span class="flow-index">{idx}</span> · {step.where}</span>
            <h3 class="flow-title">
              {step.key && <span class="key-dot" aria-hidden="true" />}
              {step.title}
            </h3>
            <p class="flow-detail">{step.detail}</p>
          </div>
        </li>
      );
    })}
  </ol>
  {note && <p class="flow-note" data-r>{note}</p>}
</div>

<style>
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 32px);
    padding-bottom: clamp(28px, 4.5vh, 40px);
  }

  .flow-step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 56px;
    bottom: 6px;
    width: 2px;
    background: radial-gradient(circle, var(--ink-3) 1px, transparent 1.4px) 0 0 / 2px 6px repeat-y;
  }

  .flow-node {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    border: 1px solid var(--rule);
    background: var(--bg-raise);
    color: var(--ink-2);
  }

  .flow-step.is-key .flow-node {
    border-color: var(--flag);
    color: var(--flag);
  }

  .flow-index {
    color: var(--ink-2);
  }

  .flow-step.is-key .flow-index {
    color: var(--flag);
  }

  .flow-body {
    min-width: 0;
  }

  .flow-where {
    display: block;
    font-family: var(--mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    margin-bottom: 6px;
    padding-top: 2px;
  }

  .flow-title {
    font-family: var(--display);
    font-weight: 380;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .key-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--flag);
    vertical-align: middle;
    margin-right: 8px;
    margin-bottom: 2px;
  }

  .flow-detail {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.5;
  }

  .flow-note {
    margin-top: clamp(24px, 4vh, 36px);
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .flow-step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 14px;
    }
    .flow-node {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }
    .flow-step:not(:last-child)::before {
      left: 19px;
      top: 48px;
    }
  }
</style>
