---
import Base from "../../layouts/Base.astro";
import { work, clearbill } from "../../data/site";

export function getStaticPaths() {
  return work.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
---

<Base title={`${w.title} — Aarya Patil`} description={w.summary}>
  <article class="case">
    <a href="/#work" class="back link-line">All work</a>
    <h1>{w.title}</h1>
    <p class="lead">{w.summary}</p>
    <p class="mono meta">{w.kind} · {w.year} · {w.stack}</p>
    {
      w.slug === "clearbill" && (
        <p class="links">
          <a class="link-line" href={clearbill.live} target="_blank" rel="noopener">Open the live app</a>
          <a class="link-line" href={clearbill.repo} target="_blank" rel="noopener">Code on GitHub</a>
        </p>
      )
    }
    <p class="pending">The full case study for this project is being written.</p>
  </article>
</Base>

<style>
  .case {
    min-height: 100vh;
    padding: 160px var(--gutter) 96px;
    max-width: 1100px;
  }
  .back {
    color: var(--ink-2);
  }
  h1 {
    margin-top: 48px;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .lead {
    margin-top: 28px;
    max-width: 40ch;
    font-family: var(--display);
    font-weight: 330;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .meta {
    margin-top: 24px;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    gap: 28px;
    margin-top: 36px;
  }
  .pending {
    margin-top: 72px;
    color: var(--ink-3);
  }
</style>
