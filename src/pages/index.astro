---
import { withBase } from "../lib/url";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter";
import { person, work } from "../data/site";

const statement =
  "Most of my day is SQL, PL/SQL and batch jobs: tuning queries, automating schedules, and fixing production failures before the SLA runs out. Outside work I build the same kind of systems end to end, where a model's output is checked before anyone acts on it.";
const marked = new Set(["production", "failures", "checked"]);
---

<Base>
  <section class="hero" data-hero aria-labelledby="hero-title">
    <h1 id="hero-title" class="headline" data-hero-head>
      <span class="hl"><span>Pipelines you</span></span>
      <span class="hl"><span>don't <span class="accent" data-accent>babysit.</span></span></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-who">
        I'm <strong>Aarya Patil</strong>, an application developer at IBM in Bengaluru.
      </p>
      <div class="hero-side">
        <p>
          By day: SQL, batch jobs and a move to AWS. On my own time: Airflow, Snowflake and AI apps where code checks
          what the model says. Everything gets tested before it ships.
        </p>
        <div class="hero-actions">
          <a class="btn" href={`mailto:${person.email}`} data-magnetic data-cursor="Email">
            <span>Let's talk</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12v7H2zM2.5 5l5.5 4.2L13.5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
          </a>
          <a class="btn btn-quiet" href="#work" data-magnetic data-cursor="Scroll">
            <span>See the work</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="work" id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title" data-pt-head>Selected work</h2>
    <div class="work-stage" data-stage-root style={`--n: ${work.length}`}>
      <div class="work-pin" data-stage-pin>
        <p class="stage-count mono" aria-hidden="true"><span data-stage-i>1</span> / {work.length}</p>
    {
      work.map((w) => (
        <article class="project" data-project data-slug={w.slug} aria-labelledby={`p-${w.slug}`}>
          <div class="project-copy">
            <h3 id={`p-${w.slug}`} class="project-title" data-pt-head>
              {w.title.split(" ").map((word, i) => (
                <Fragment>
                  <span class="w" style={`--i: ${i}`}><span>{word}</span></span>{" "}
                </Fragment>
              ))}
            </h3>
            <p class="project-summary">
              {w.summary.split(" ").map((word, i) => (
                <Fragment>
                  <span class="sw" style={`--i: ${i}`}>{word}</span>{" "}
                </Fragment>
              ))}
            </p>
            <dl class="project-meta">
              <div><dt>Stack</dt><dd class="mono">{w.stack}</dd></div>
              <div><dt>Context</dt><dd class="mono">{w.kind} · {w.year}</dd></div>
            </dl>
            <p class="project-links">
              <a class="btn btn-quiet" href={withBase(`/work/${w.slug}/`)} data-cursor="Read" data-magnetic>Read the case study</a>
              {w.live && (
                <a class="quiet link-line" href={w.live} target="_blank" rel="noopener" data-cursor="Live app" data-magnetic>Open the live app</a>
              )}
            </p>
          </div>
          <figure class="project-art" data-art={w.slug}>
            <a class="art-link" href={withBase(`/work/${w.slug}/`)} data-cursor="View" aria-label={`${w.title}: read the case study`}>
              <div class="art-box" data-art-box></div>
            </a>
          </figure>
        </article>
      ))
    }
      </div>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <h2 id="about-title" class="section-title" data-pt-head>About me</h2>
    <div class="read-block" data-read-block>
      <div class="read-pin">
        <p class="about-lead" data-read>
          {statement.split(" ").map((word) => (
            <Fragment>
              <span class="rw" data-mark={marked.has(word.replace(/[^\w]/g, "")) ? "" : undefined}>{word}</span>{" "}
            </Fragment>
          ))}
        </p>
      </div>
    </div>
    <div class="about-cols">
      <p>
        I like problems where the data is messy and the rules are published somewhere. ClearBill started that way: hospital
        bills in India are hard to read, but what insurers won't pay for is written down by IRDAI, and drug price
        ceilings by NPPA. So the model only reads, and code does the judging.
      </p>
      <p>
        I'm looking for data engineering and DevOps roles, including teams building with LLMs. I test before I ship,
        say what I haven't finished, and keep the boring parts boring.
      </p>
    </div>
  </section>

  <section class="exp" id="experience" aria-labelledby="exp-title">
    <h2 id="exp-title" class="section-title" data-pt-head>Experience</h2>
    <div class="exp-statement">
      <header class="exp-head">
        <h3 class="exp-co">IBM</h3>
        <div class="exp-meta">
          <p>Application Developer</p>
          <p>Enterprise BFSI data and batch systems</p>
          <p class="mono">Aug 2024 – now</p>
        </div>
      </header>
      <ul class="exp-claims">
        <li><p class="exp-claim">Cut a claims batch from <em>50 to 35 minutes</em>.</p><p class="exp-how">Query tuning and execution-plan work.</p></li>
        <li><p class="exp-claim">Automated scheduling: <em>25% less manual work</em>.</p><p class="exp-how">Control-M and UNIX shell scripts for scheduling and file handling.</p></li>
        <li><p class="exp-claim">Worked on the move <em>from on-prem to AWS</em>.</p><p class="exp-how">S3 buckets and file processing, monitored with CloudWatch, EC2 and EMR.</p></li>
        <li><p class="exp-claim">Fixed production batch failures <em>within SLA</em>.</p><p class="exp-how">Root-caused across data, SQL and scheduling; validated through SIT and UAT.</p></li>
      </ul>
      <div class="exp-foot">
        <div class="exp-edu">
          <h3>Education</h3>
          <ul>
          <li><span>B.E. Computer Science, AISSMS College of Engineering</span><span class="mono">2021–24 · CGPA 8.98</span></li>
          <li><span>Diploma, Computer Science, Sanjay Ghodawat Polytechnic</span><span class="mono">2018–21 · 96.59%</span></li>
          </ul>
        </div>
        <div>
          <h3>Certifications</h3>
          <ul class="exp-tags">
            <li>AWS Certified AI Practitioner</li>
            <li>AWS Certified Cloud Practitioner</li>
            <li>Claude Certified Developer – Foundations</li>
            <li>Oracle Database SQL Certified Associate</li>
          </ul>
        </div>
      </div>
    </div>
  </section>



  <div id="contact" data-footer>
    <SiteFooter client:visible />
  </div>
</Base>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 680px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 110px var(--gutter) clamp(32px, 5vh, 56px);
  }

  .headline {
    align-self: center;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3.4rem, 12.6vw, 20rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }
  .hl {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
    white-space: nowrap;
  }
  .hl > span {
    display: block;
  }
  .accent {
    color: var(--flag);
  }
  :global(html.river) .headline,
  :global(html.river) .headline .accent {
    color: transparent;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 5vw, 96px);
    align-items: end;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .hero-who {
    font-family: var(--display);
    font-weight: 330;
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 24ch;
    color: var(--ink-2);
  }
  .hero-who strong {
    font-weight: 420;
    color: var(--ink);
  }
  .hero-side p {
    color: var(--ink-2);
    max-width: 46ch;
  }
  .hero-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 16px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 560;
    font-size: 0.98rem;
    transition: background-color 0.25s ease;
  }
  .btn svg {
    width: 14px;
    height: 14px;
  }
  @media (hover: hover) {
    .btn:hover {
      background: #fff;
    }
  }
  .quiet {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  @media (hover: hover) {
    .quiet:hover {
      color: var(--ink);
    }
  }

  /* Work */
  .work {
    position: relative;
    padding: clamp(96px, 14vh, 180px) var(--gutter) 80px;
  }
  .section-title {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: clamp(36px, 5vw, 72px);
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    min-height: 92vh;
    padding: clamp(48px, 8vh, 96px) 0;
    border-top: 1px solid var(--rule);
  }
  .project-title {
    font-family: var(--display);
    font-weight: 330;
    font-size: clamp(2.6rem, 5.4vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .project-summary {
    margin-top: 28px;
    max-width: 46ch;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .project-meta {
    margin-top: 28px;
    display: grid;
    gap: 10px;
  }
  .project-meta div {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .project-meta dt {
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .project-meta dd {
    color: var(--ink-2);
  }
  .project-links {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
  }
  .btn-quiet {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink-3);
    transition:
      box-shadow 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }
  @media (hover: hover) {
    .btn-quiet:hover {
      background: var(--ink);
      color: var(--bg);
      box-shadow: inset 0 0 0 1px var(--ink);
    }
  }
  .btn {
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.3s var(--ease-out);
  }
  .btn.is-pressed {
    transform: scale(0.96);
  }
  .art-link.is-pressed .art-box {
    transform: scale(0.985);
  }
  .art-box {
    transition: transform 0.4s var(--ease-out);
  }
  @media (pointer: coarse) {
    .btn {
      min-height: 48px;
      justify-content: center;
    }
    .link-line {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  .project-art {
    position: relative;
  }
  .art-box {
    width: 100%;
    aspect-ratio: 7 / 5;
    max-height: 72vh;
  }
  .stage-count {
    display: none;
  }

  /* Pinned stage: one project per scroll step, desktop with particles only. */
  :global(html.stage) .work-stage {
    height: calc((var(--n) + 0.4) * 100vh);
  }
  :global(html.stage) .work-pin {
    position: sticky;
    top: 0;
    height: 100vh;
  }
  :global(html.stage) .stage-count {
    display: block;
    position: absolute;
    right: 0;
    top: 104px;
    color: var(--ink-2);
  }
  :global(html.stage) .project {
    position: absolute;
    inset: 0;
    min-height: 0;
    padding: 96px 0 48px;
    border-top: 0;
    pointer-events: none;
  }
  :global(html.stage) .project.is-active {
    pointer-events: auto;
  }
  /* Project change: title words slide through a mask, summary words rise out of a blur. */
  :global(html.stage) .project-title .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  :global(html.stage) .project-title .w > span {
    display: inline-block;
    transform: translateY(108%) rotate(4deg);
    transform-origin: 0 100%;
    transition: transform 0.5s var(--ease-out);
  }
  :global(html.stage) .project.is-active .project-title .w > span {
    transform: none;
    transition: transform 1.05s cubic-bezier(0.19, 1, 0.22, 1) calc(0.12s + var(--i) * 0.07s);
  }
  :global(html.stage) .project.is-past .project-title .w > span {
    transform: translateY(-108%) rotate(-3deg);
    transition: transform 0.55s cubic-bezier(0.7, 0, 0.84, 0) calc(var(--i) * 0.04s);
  }
  :global(html.stage) .project-summary .sw {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(0.5em);
    transition:
      opacity 0.25s ease,
      filter 0.25s ease,
      transform 0.3s ease;
  }
  :global(html.stage) .project.is-active .project-summary .sw {
    opacity: 1;
    filter: none;
    transform: none;
    transition:
      opacity 0.6s ease calc(0.35s + var(--i) * 0.012s),
      filter 0.7s ease calc(0.35s + var(--i) * 0.012s),
      transform 0.8s var(--ease-out) calc(0.35s + var(--i) * 0.012s);
  }
  :global(html.stage) .project-meta,
  :global(html.stage) .project-links {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.3s ease,
      transform 0.4s ease;
  }
  :global(html.stage) .project.is-active .project-meta,
  :global(html.stage) .project.is-active .project-links {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease 0.75s,
      transform 0.9s var(--ease-out) 0.75s;
  }
  :global(html.stage) .project.is-active .project-links {
    transition-delay: 0.85s;
  }
  :global(html.stage) .stage-count span {
    display: inline-block;
  }

  :global(html.pt) [data-pt-head] {
    opacity: 0;
  }

  /* About */
  .about {
    padding: clamp(96px, 16vh, 200px) var(--gutter);
    border-top: 1px solid var(--rule);
  }
  .about-lead {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(1.7rem, 2.9vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.022em;
    max-width: 32ch;
    text-wrap: balance;
  }
  .about-cols {
    margin-top: clamp(40px, 5vw, 72px);
    margin-left: auto;
    width: min(100%, 860px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    color: var(--ink-2);
  }

  /* Experience */
  .exp {
    padding: clamp(80px, 12vh, 160px) var(--gutter);
    border-top: 1px solid var(--rule);
  }
  .exp-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 32px;
    align-items: end;
    padding-bottom: 36px;
  }
  .exp-co {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(6rem, 17vw, 16rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    margin-left: -0.05em;
  }
  .exp-meta {
    display: grid;
    gap: 4px;
    padding-bottom: 0.6em;
  }
  .exp-meta p {
    color: var(--ink-2);
  }
  .exp-meta p:first-child {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .exp-claims {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--rule);
  }
  .exp-claims li {
    padding: 36px 40px 36px 0;
    border-bottom: 1px solid var(--rule);
  }
  .exp-claims li:nth-child(even) {
    padding-left: 40px;
    border-left: 1px solid var(--rule);
  }
  .exp-claim {
    font-family: var(--display);
    font-weight: 330;
    font-size: clamp(1.6rem, 2.6vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }
  .exp-claim em {
    font-style: normal;
    color: var(--flag);
  }
  .exp-how {
    margin-top: 14px;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .exp-foot {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    margin-top: 56px;
  }
  .exp-foot h3 {
    font-size: 0.95rem;
    font-weight: 560;
    margin-bottom: 14px;
  }
  .exp-edu li {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .exp-edu .mono {
    color: var(--ink-3);
  }
  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .exp-tags li {
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  /* About: a statement read by scrolling */
  :global(html.read) .read-block {
    height: 160vh;
  }
  :global(html.read) .read-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    align-content: center;
  }
  :global(html.read) .about-lead {
    font-size: clamp(2rem, 3.7vw, 3.6rem);
    max-width: 28ch;
  }
  .rw[data-mark] {
    color: var(--flag);
  }

  .art-link {
    display: block;
    border-radius: 12px;
  }
  .art-link:focus-visible {
    outline-offset: 8px;
  }

  @media (max-width: 1000px) {
    .hero {
      min-height: 100svh;
      padding-top: 104px;
      gap: 32px;
    }
    .headline {
      align-self: end;
      font-size: clamp(3.2rem, 16vw, 8rem);
    }
    .hl {
      white-space: normal;
    }
    .hero-foot {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .project {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 28px;
    }
    .about-cols,
    .exp-head,
    .exp-foot,
    .exp-claims {
      grid-template-columns: 1fr;
    }
    .exp-claims li:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 1000px) {
    /* Show the thing first, then explain it. */
    .project-art {
      order: -1;
    }
    .project {
      padding: clamp(40px, 8vw, 72px) 0;
    }
    .art-box {
      max-height: none;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: max(96px, calc(72px + env(safe-area-inset-top)));
      /* Clear the section dock so both buttons sit above it on first view. */
      padding-bottom: calc(92px + env(safe-area-inset-bottom));
    }
    .headline {
      font-size: clamp(3.2rem, 16vw, 5rem);
    }
    .hero-who {
      font-size: 1.45rem;
      max-width: 22ch;
    }
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 22px;
    }
    .hero-actions .btn {
      width: 100%;
      min-height: 52px;
    }
    .art-box {
      aspect-ratio: 6 / 5;
    }
    .project-title {
      font-size: clamp(2.5rem, 13vw, 3.4rem);
    }
    .project-summary {
      margin-top: 20px;
      font-size: 1rem;
    }
    .project-links {
      display: grid;
      gap: 10px;
      margin-top: 28px;
    }
    .project-links .btn,
    .project-links .link-line {
      width: 100%;
      justify-content: center;
    }
    .project-links .link-line {
      box-shadow: inset 0 0 0 1px var(--rule);
      border-radius: 999px;
      background-image: none;
      color: var(--ink-2);
    }
    .section-title {
      font-size: clamp(2.8rem, 15vw, 4rem);
    }
    .exp-claims li {
      padding: 28px 0;
    }
    .exp-claim {
      font-size: 1.7rem;
      max-width: none;
    }
    .exp-tags {
      gap: 8px;
    }
    .exp-tags li {
      padding: 10px 14px;
    }
  }
</style>
